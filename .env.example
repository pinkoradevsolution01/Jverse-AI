NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Never expose this in NEXT_PUBLIC variables or Electron renderer code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only JVerse Node control-plane connection. Never expose these as NEXT_PUBLIC values.
AI_CONTROL_PLANE_URL=https://your-jverse-control-plane.example.com
AI_CONTROL_PLANE_TOKEN=replace-with-a-long-random-server-to-server-token

# Server-only public Python Agent URL. Required for the agent-authorized
# Electron command approval routes; never point this at localhost on Vercel.
PYTHON_AGENT_URL=https://your-jverse-brain.example.com
