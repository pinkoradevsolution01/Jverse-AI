# Local dependencies and build caches are installed/generated by Vercel.
node_modules/
.next/
.git/
.vercel/

# Desktop-only distribution assets are not part of the Next.js deployment.
electron/node_modules/
electron/dist/
electron/release/
.tools/

# Local AI models and Python packaging output belong to the desktop Agent.
services/brain/models/
services/brain/venv/
services/brain/build/
services/brain/*.egg-info/

# Local credentials and OS/editor artifacts.
.env*
*.pem
.DS_Store
